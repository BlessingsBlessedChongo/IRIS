# Copy this file to .env (same folder) and adjust as needed.
# Relative paths are resolved against the repo root, wherever uvicorn is started from.

# -- Input source: mp4 | webcam | rtsp ---------------------------------------
IRIS_SOURCE=mp4
IRIS_MP4_PATH=./data/sample.mp4
# Optional: rotate through several clips (comma-separated, no spaces).
# When set, this takes priority over IRIS_MP4_PATH.
# IRIS_MP4_PATHS=./data/sample1.mp4,./data/sample2.mp4,./data/sample3.mp4
IRIS_WEBCAM_INDEX=0
IRIS_RTSP_URL=

# -- Model ---------------------------------------------------------------------
IRIS_MODEL_PATH=./models/iris_yolov8n.onnx
IRIS_MODEL_FALLBACK=yolov8n.pt
IRIS_CONF_THRESHOLD=0.75
IRIS_IMG_SIZE=416

# -- Alert tiers: consecutive frames with a detection before each tier fires -------
IRIS_TIER1_FRAMES=1
IRIS_TIER2_FRAMES=3
IRIS_TIER3_FRAMES=5

# -- MQTT (simulated PLC trip) -------------------------------------------------------
IRIS_MQTT_ENABLED=true
IRIS_MQTT_HOST=localhost
IRIS_MQTT_PORT=1883
IRIS_MQTT_TOPIC=iris/plc/trip

# -- Server --------------------------------------------------------------------------
IRIS_HOST=0.0.0.0
IRIS_PORT=8000
IRIS_FPS_TARGET=25
IRIS_STREAM_RECONNECT_SECONDS=5
